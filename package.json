{
  "name": "@houthoofd/unitix",
  "version": "0.6.0",
  "description": "Test stub generator for Clean Architecture projects (TypeScript / Jest / Vitest)",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "unitix": "./bin/unitix"
  },
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "test": "node --test tests/unit/utils/sync-merger.test.mjs tests/unit/utils/ast-cache.test.mjs tests/unit/utils/parse-error.test.mjs tests/unit/core/cli.test.mjs tests/unit/templates/backend-use-case.test.mjs tests/unit/templates/frontend-component.test.mjs tests/unit/templates/frontend-hook.test.mjs"
  },
  "keywords": [
    "test-generator",
    "clean-architecture",
    "typescript",
    "jest",
    "vitest",
    "scaffold",
    "unitix",
    "tdd"
  ],
  "author": "Benoit Houthoofd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Houthoofd/Unitix.git"
  },
  "bugs": {
    "url": "https://github.com/Houthoofd/Unitix/issues"
  },
  "homepage": "https://github.com/Houthoofd/Unitix#readme",
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
